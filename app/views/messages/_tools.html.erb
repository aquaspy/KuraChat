<nav class="msg-toolbar" data-controller="copy" data-copy-copied-value="<%= t("app.copied") %>" data-copy-idle-value="<%= t("app.copy") %>">
  <textarea class="sr-only" readonly tabindex="-1" aria-hidden="true" data-copy-target="source"><%= message.content %></textarea>
  <button type="button" class="msg-tool" data-action="copy#copy" title="<%= t("app.copy") %>">
    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.2" y="5.2" width="7.2" height="8.2" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M3.6 10.8V3.8A1.2 1.2 0 0 1 4.8 2.6h5.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
    <span data-copy-target="label"><%= t("app.copy") %></span>
  </button>
  <%= render "messages/citations", message: message %>
</nav>

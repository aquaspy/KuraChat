<% urls = Array(message.citations).filter_map { |c| hash = c.respond_to?(:to_unsafe_h) ? c.to_unsafe_h : c; [hash["title"] || hash[:title], safe_citation_url(hash["url"] || hash[:url])] }.select { |_, uri| uri } %>
<% if urls.any? %>
  <details class="cite-fold">
    <summary>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 9.8 9.8 6.2M7.1 4.4l.6-1.1a2.2 2.2 0 0 1 3.8 2.2l-.6 1.1M8.9 11.6l-.6 1.1a2.2 2.2 0 1 1-3.8-2.2l.6-1.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      <%= t("chat.sources") %>
      <span class="cite-fold-n"><%= urls.size %></span>
    </summary>
    <ul class="citations">
      <% urls.each do |title, uri| %>
        <li><%= link_to (title.presence || uri.host), uri.to_s, rel: "noopener noreferrer nofollow", target: "_blank" %></li>
      <% end %>
    </ul>
  </details>
<% end %>

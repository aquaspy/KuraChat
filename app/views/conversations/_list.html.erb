<nav class="note-list" id="conversation-list" data-controller="confirm">
  <% if @conversations.blank? %>
    <p class="empty-list muted"><%= t("chat.empty_list") %></p>
  <% else %>
    <% @conversations.each do |conversation| %>
      <div class="note-item <%= "is-on" if @conversation&.id == conversation.id %>">
        <%= link_to conversation_path(conversation, q: @query), class: "note-item-link" do %>
          <%= render "conversations/title", conversation: conversation %>
        <% end %>
        <button type="button" class="icon-btn danger note-delete" data-action="confirm#open" data-url="<%= conversation_path(conversation) %>" data-message="<%= t("chat.delete_confirm") %>" title="<%= t("app.delete") %>" aria-label="<%= t("app.delete") %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 4.4h9.6M6.2 4.4V3.2h3.6v1.2M5.1 6.2l.4 6.2h5l.4-6.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    <% end %>
    <dialog class="confirm-dialog" data-confirm-target="box" data-action="click->confirm#backdrop">
      <p data-confirm-target="message"><%= t("chat.delete_confirm") %></p>
      <div class="confirm-actions">
        <button type="button" class="btn-dialog" data-action="confirm#close"><%= t("app.cancel") %></button>
        <%= link_to t("app.delete"), conversations_path, class: "btn-dialog danger", data: { confirm_target: "destroy", turbo_method: :delete } %>
      </div>
    </dialog>
  <% end %>
</nav>

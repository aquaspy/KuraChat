# Copy to .env and fill in. Then:
#   docker compose up -d --build
# After editing .env, apply with:
#   docker compose up -d
# (compose restart keeps the old env; up -d recreates the container.)

# Pick one. SECRET_KEY_BASE is enough for Compose.
#   openssl rand -hex 64
SECRET_KEY_BASE=

# Optional. Only if you use Rails credentials instead of SECRET_KEY_BASE.
# From config/master.key after: EDITOR=true bin/rails credentials:edit
# A random value will not decrypt the credentials.yml.enc in git.
RAILS_MASTER_KEY=

# Public signup form. true for the first account, then flip to false.
SIGNUP_ENABLED=true

# Set true when your own Caddy/nginx terminates HTTPS in front.
# Required for Action Cable when the browser origin is https://
FORCE_SSL=false

# Your public hostname. Comma-separated if you have more than one.
# Leave empty only while testing. Share links use the request host.
KURA_HOST=chat.example.com

# Publish only on localhost so 80/443 stay free for your proxy.
# Point Caddy or nginx at 127.0.0.1:3000. Proxy /cable with WebSocket upgrade.
BIND=127.0.0.1:3000

# xAI — required for replies. Keys stay on the server.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_REASONING_EFFORT=low
# XAI_WEB_REASONING_EFFORT=medium     # Web turns only. low is cheaper; medium synthesizes search better.
# XAI_MODEL=grok-4.6                  # Stronger tool use. About 1.6× input / 2.4× output vs 4.3.

# Web search for the Web toggle. The UI only turns search on or off;
# the provider is picked here. kagi (default) or brave.
WEB_SEARCH_PROVIDER=kagi
KAGI_API_KEY=
KAGI_EXTRACT_COUNT=3
# KAGI_REGION=BR                      # Search region. Default BR when UI is pt. ALL omits the filter.
# BRAVE_API_KEY=
# BRAVE_ENDPOINT=auto                 # auto: LLM Context if the plan has it, else web/search. llm or web skips the probe.
# BRAVE_CONTEXT_TOKENS=8192           # Brave LLM Context budget (1024–32768)
# BRAVE_COUNTRY=BR                    # Search country. Default BR when UI is pt, else US. ALL omits the filter.
# BRAVE_SEARCH_LANG=                  # Leave unset. Pinning to pt makes global/tech results worse.

# How much history Grok sees. Compact kicks in after KEEP_RECENT visible messages.
# CHAT_KEEP_RECENT=16
# CHAT_WINDOW_TOKENS=32000
